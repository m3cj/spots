# Google Maps JavaScript API key. Visible in the bundle by design: restrict it by HTTP referrer + API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID is required for Advanced Markers. DEMO_MAP_ID works in development only.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google OAuth 2.0 Web client ID (public). The client secret lives in server/.env only.
VITE_GOOGLE_CLIENT_ID=

# Leave empty to call same-origin /api (Vite proxy in dev, Vercel rewrite in production).
VITE_API_BASE_URL=
