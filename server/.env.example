NODE_ENV=development
PORT=3000

# Browser origin(s) allowed to call the API, comma-separated (your Vercel URL in production).
CLIENT_ORIGIN=http://localhost:5173

# Proxy hops in front of this server. Render adds one (default 1 in production, 0 otherwise).
# If Vercel rewrites /api to this server, set 2 so rate limits see the visitor and not Vercel.
# TRUST_PROXY=1

# lax works when the site and API share a registrable domain (localhost, or app.example.com + api.example.com).
# Use none only for a cross-site API (vercel.app + onrender.com); some browsers block those cookies anyway.
COOKIE_SAMESITE=lax

# Supabase: Project Settings > API. The service-role key bypasses RLS: server-side only, never in the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=spots-media

# Google OAuth 2.0 Web client. The redirect URI must also be listed under Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Two different random strings of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
